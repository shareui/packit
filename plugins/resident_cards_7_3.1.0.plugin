# Безопасные прокси-классы для обработки кликов и закрытия диалогов
try:
    from java import dynamic_proxy

    class OnDismissListenerProxy(dynamic_proxy(DialogInterface.OnDismissListener)):
        def __init__(self, callback):
            super().__init__()
            self.callback = callback

        def onDismiss(self, dialog):
            if self.callback:
                try:
                    self.callback(dialog)
                except Exception as ex:
                    log(f"onDismiss error: {ex}")

    class OnClickListenerProxy(dynamic_proxy(DialogInterface.OnClickListener)):
        def __init__(self, callback):
            super().__init__()
            self.callback = callback

        def onClick(self, dialog, which):
            if self.callback:
                try:
                    self.callback(dialog, which)
                except Exception as ex:
                    log(f"onClick error: {ex}")
except Exception:
    class OnDismissListenerProxy:
        def __init__(self, callback):
            self.callback = callback

        def onDismiss(self, dialog):
            if self.callback:
                try:
                    self.callback(dialog)
                except Exception as ex:
                    log(f"onDismiss fallback error: {ex}")

    class OnClickListenerProxy:
        def __init__(self, callback):
            self.callback = callback

        def onClick(self, dialog, which):
            if self.callback:
                try:
                    self.callback(dialog, which)
                except Exception as ex:
                    log(f"onClick fallback error: {ex}")

# WebViewClient для перехвата команды закрытия exteragram://close
try:
    class GameWebViewClient(dynamic_proxy(WebViewClient)):
        def __init__(self, close_callback):
            super().__init__()
            self.close_callback = close_callback

        def shouldOverrideUrlLoading(self, view, url_or_request):
            try:
                url_str = str(url_or_request.getUrl()) if hasattr(url_or_request, "getUrl") else str(url_or_request)
                if "exteragram://close" in url_str:
                    if self.close_callback:
                        self.close_callback()
                    return True
            except Exception as ex:
                log(f"shouldOverrideUrlLoading error: {ex}")
            return False
except Exception as ex:
    log(f"GameWebViewClient init error: {ex}")
    class GameWebViewClient:
        def __init__(self, close_callback):
            self.close_callback = close_callback

# WebChromeClient для обработки alert("exteragram_close")
try:
    cls_WebChromeClient = find_class("android.webkit.WebChromeClient")
    class GameWebChromeClient(dynamic_proxy(cls_WebChromeClient)):
        def __init__(self, close_callback):
            super().__init__()
            self.close_callback = close_callback

        def onJsAlert(self, view, url, message, result):
            try:
                if str(message) == "exteragram_close":
                    if self.close_callback:
                        self.close_callback()
                    result.confirm()
                    return True
            except Exception as ex:
                log(f"onJsAlert error: {ex}")
            return False

        def onConsoleMessage(self, consoleMessage):
            try:
                msg = str(consoleMessage.message()) if consoleMessage else ""
                if "exteragram_close" in msg:
                    if self.close_callback:
                        self.close_callback()
                    return True
            except Exception as ex:
                log(f"onConsoleMessage error: {ex}")
            return False
except Exception as ex:
    log(f"GameWebChromeClient init error: {ex}")
    class GameWebChromeClient:
        def __init__(self, close_callback):
            self.close_callback = close_callback


__id__ = "resident_cards_7"
__name__ = "Resident Evil 7: Banned Footage, «21»"
__description__ = (
    "Ёбаный стыд и позор наконец сделан, представляю вашему вниманию!\n"
    "Почти полноценно работающую копию карточную игру из игры Resident Evil 7: Biohazard, дополнение «Вырезанные материалы» «21»\n"
    "\n"
    "Три режима игры против заебавшего всех мешка: Отрубалка пальцев, циркулярка и электростул, на котором вас сожгут под напряжением в 67000ватт\n"
    "Пресеты для чуть более интересной игры, хотите очень быстрые раунды? режим «По-крупному» вас явно заинтересует, а если вы хотите войти в раздумия и полное отупение? Думаю вам стоит «затянуться» в предшествующем режиме, которое явно будет долго, не смотря на быстрые раунды даже в обычных играх\n"
    "\n"
    "Наслаждайтесь этим говном если понравится, потом мб завезу немного текстур и звуков, чтоб лучше выглядело"
)
